{
  "name": "@meteora-ag/dlmm-pro-sdk",
  "version": "1.0.0",
  "description": "A Typescript SDK for interacting with the DLMM Pro program on Meteora.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "source": "src/index.ts",
  "author": "Dann Wee <dann@raccoons.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteoraAg/dlmm-pro-sdk.git"
  },
  "keywords": [
    "meteora-ag",
    "dlmm-pro"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm,cjs && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "format": "prettier --check .",
    "test": "vitest run"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@coral-xyz/borsh": "0.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.3",
    "vitest": "^4.1.11",
    "litesvm": "^1.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}

{
  "name": "@meteora-ag/dlmm-pro-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Meteora DLMM Pro program.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./idl/dlmm-pro": "./dist/idl/dlmm-pro/dlmm_pro.json",
    "./idl/access-registry": "./dist/idl/access-registry/access_registry.json"
  },
  "source": "src/index.ts",
  "author": "Dann Wee <dann@raccoons.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteoraAg/dlmm-pro-sdk.git"
  },
  "keywords": [
    "meteora-ag",
    "dlmm-pro"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm,cjs && tsc -p tsconfig.build.json && mkdir -p dist/idl/dlmm-pro dist/idl/access-registry && cp src/idl/dlmm-pro/dlmm_pro.json dist/idl/dlmm-pro/ && cp src/idl/access-registry/access_registry.json dist/idl/access-registry/",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:charts": "DLMM_CHARTS=1 vitest run",
    "test:rust": "cargo test --workspace",
    "test:all": "pnpm test && pnpm test:rust",
    "test:watch": "vitest"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@coral-xyz/borsh": "0.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/babar": "^0.2.4",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.3",
    "babar": "^0.2.3",
    "litesvm": "0.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
